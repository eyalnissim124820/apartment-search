PORT=3001
# json (default) | supabase
STORAGE=json
DATA_FILE=data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Web Push (optional – generated automatically if unset)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Free OpenStreetMap services (override to self-host)
GEOCODER_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# Protects /api/cron/reminders (scheduler sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Time zone for reminder text
TZ_DISPLAY=Asia/Jerusalem

# Optional paid scraping fallback for sites that block servers (Yad2, Madlan): https://www.scrapingbee.com
SCRAPINGBEE_API_KEY=

# Automatic Yad2 search scan via Apify (https://console.apify.com → Settings → API & Integrations)
APIFY_TOKEN=
# Optional: actor (default amit123/YadScraper), results per search per scan (default 20), per-run spend cap in USD (default 0.5)
APIFY_YAD2_ACTOR=
APIFY_YAD2_MAX_ITEMS=
APIFY_MAX_CHARGE_USD=
# Optional: Madlan actor for the automatic scan (default swerve/madlan-scraper)
APIFY_MADLAN_ACTOR=
