PORT=3001
# json (default) | supabase
STORAGE=json
DATA_FILE=data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Web Push (optional – generated automatically if unset)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Free OpenStreetMap services (override to self-host)
GEOCODER_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# Protects /api/cron/reminders (scheduler sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Time zone for reminder text
TZ_DISPLAY=Asia/Jerusalem
